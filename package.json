{
  "name": "codearchaeologist-ai",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scanner:worker": "node --experimental-transform-types --import ./scripts/register-types.mjs scripts/scanner-worker.ts",
    "scanner:dispatcher": "node --experimental-transform-types --import ./scripts/register-types.mjs scripts/scanner-dispatcher.ts",
    "demo:report": "node --env-file=.env.local --experimental-transform-types --import ./scripts/register-types.mjs scripts/generate-demo-report.ts",
    "demo:reverify": "node --experimental-transform-types --import ./scripts/register-types.mjs scripts/reverify-demo-report.ts",
    "archaeology:scan": "node --experimental-transform-types --import ./scripts/register-types.mjs scripts/scan-archaeology.ts",
    "archaeology": "node --experimental-transform-types --import ./scripts/register-types.mjs scripts/scan-archaeology.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
