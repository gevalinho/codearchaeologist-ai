# Select one live provider explicitly: baseten or meta.
INVESTIGATION_PROVIDER=baseten

# Local-only opt-in for the paid dashboard investigation button.
# ENABLE_LIVE_INVESTIGATION_HTTP=1

# Baseten Model APIs. Keep the real key only in ignored .env.local or server secrets.
BASETEN_API_KEY=
# Hackathon model ID confirmed by onboarding email.
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
# Optional; default is https://inference.baseten.co/v1/chat/completions
# BASETEN_MODEL_ENDPOINT=https://inference.baseten.co/v1/chat/completions

# Direct Meta Model API, used only when INVESTIGATION_PROVIDER=meta.
# MODEL_API_KEY=
# META_MODEL_ID=muse-spark-1.3
