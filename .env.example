# Select one live provider explicitly: baseten or meta.
INVESTIGATION_PROVIDER=baseten

# Local-only opt-in for the paid dashboard investigation button.
# ENABLE_LIVE_INVESTIGATION_HTTP=1

# Baseten Model APIs. Keep the real key only in ignored .env.local or server secrets.
BASETEN_API_KEY=
# Hackathon model ID confirmed by onboarding email.
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
# Optional; default is https://inference.baseten.co/v1/chat/completions
# BASETEN_MODEL_ENDPOINT=https://inference.baseten.co/v1/chat/completions

# Direct Meta Model API, used only when INVESTIGATION_PROVIDER=meta.
# MODEL_API_KEY=
# META_MODEL_ID=muse-spark-1.3

# Optional controlled public GitHub ingestion. Set all three on a single trusted server.
# ENABLE_GITHUB_INGESTION=1
# GITHUB_INGESTION_ORIGIN=https://your-exact-app-origin.example
# GITHUB_INGESTION_ACCESS_KEY=<random secret of at least 32 characters; share out of band>

# Dedicated CodeArchaeologist GitHub App. All values are server-only.
# GITHUB_APP_ID=<numeric App ID>
# GITHUB_APP_CLIENT_ID=<App client ID>
# GITHUB_APP_CLIENT_SECRET=<App client secret>
# GITHUB_APP_SLUG=<App URL slug>
# GITHUB_APP_PRIVATE_KEY=<PEM private key with literal \n between lines>
# GITHUB_APP_SESSION_SECRET=<random secret of at least 32 characters>
# GITHUB_APP_ORIGIN=https://your-exact-app-origin.example

# Optional Phase 6.2 AI interpretation. Requires INVESTIGATION_PROVIDER and its server-only API key.
# ENABLE_FEATURE_AI=1
# FEATURE_AI_ORIGIN=https://your-exact-app-origin.example
# FEATURE_AI_MAX_OUTPUT_TOKENS=3000
# ENABLE_DEV_FEATURE_AI=1 # localhost development only; production AI remains disabled
